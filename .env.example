# Database
DATABASE_URL="postgresql://mcq:mcq_dev_password@localhost:5432/mcq_exam?schema=public"

# Authentication
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Session lifetime in seconds (default 30 days)
SESSION_MAX_AGE="2592000"

# Public site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="MCQ Prep"
NEXT_PUBLIC_SITE_TAGLINE="Practice MCQs for jobs, admissions and competitive exams"

# Email (optional). When SMTP_* is unset, transactional emails are logged to the
# server console instead of being sent. Set these to enable real delivery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="MCQ Prep <no-reply@example.com>"

# Rate limiting / abuse protection
RATE_LIMIT_CONTACT_PER_HOUR="5"

# Node environment
NODE_ENV="development"
